# -------------------------
# Python / Flask backend
# -------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.sqlite3

# Virtual environments
.venv/
env/
venv/

# Packaging
*.egg-info/
.eggs/
*.egg
dist/
build/

# Alembic
migrations/__pycache__/
migrations/*.pyc
# keep migrations/versions/*.py (schema history)
!migrations/versions/*.py

# Local config / secrets
# Block all environment files by default (contain secrets)
**/.env
**/.env.local
**/.env.*.local
**/.env.production
**/.env.staging
**/.env.development
**/.env.test
!**/.env.example
!**/.env.*.example

# Allow frontend environment configs (not secrets - just backend URLs)
!frontend/.env.production
!frontend/.env.staging
!frontend/.env.preview

# Certificates and keys
*.key
*.pem
*.crt
*.csr

# Additional sensitive file patterns
*.p12
*.keystore
*_rsa
*_ed25519
id_rsa*
id_dsa*
known_hosts

# JSON files - block secrets, allow configs
# Block service account and credential files
*service-account*.json
*-credentials.json
*-key.json
*_key.json
backend/mm-poker-tracker-*.json
secrets.json
credentials.json
gcp-*.json
firebase-*.json

# Allow build and deployment configs
!vercel.json
!tsconfig.json
!package.json
!package-lock.json
!tailwind.config.js
!.github/**/*.json

# Production secrets
secrets/
ssl/
certs/

# -------------------------
# Node / React frontend
# -------------------------
node_modules/
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Backups
backups/
*.sql
*.sql.gz
*.dump

# TypeScript
*.tsbuildinfo

# -------------------------
# OS / Editors
# -------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# -------------------------
# Docker
# -------------------------
*.pid

# -------------------------
# Claude Code
# -------------------------
CLAUDE.md
.claude/
