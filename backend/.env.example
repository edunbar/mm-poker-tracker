# =============================================================================
# HomeGame Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control - it contains secrets!

# =============================================================================
# Clerk Authentication
# =============================================================================
# Get these from your Clerk dashboard: https://dashboard.clerk.com
# Required for user authentication and JWT verification
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Example for local development:
DATABASE_URL=postgresql://pokeruser:supersecret@localhost:5432/poker_analytics

# For GCP Cloud SQL (production/staging), use socket path format:
# DATABASE_URL=postgresql://user:password@/database?host=/cloudsql/project:region:instance

# =============================================================================
# Email Service (SendGrid)
# =============================================================================
# Required for bug reports and notifications
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Email addresses
FROM_EMAIL=noreply@homegame.gg
BUG_REPORT_EMAIL=bugs@homegame.gg

# =============================================================================
# Application Configuration
# =============================================================================
# Environment mode: development, staging, production
FLASK_ENV=development

# Enable V2 domain-driven services (recommended: true)
USE_DOMAIN_SERVICES=true

# CORS allowed origins (comma-separated, no spaces)
# Development: allow localhost
ALLOWED_ORIGINS=http://localhost:3000

# Production example:
# ALLOWED_ORIGINS=https://homegame.gg,https://www.homegame.gg

# Frontend URL for links in emails, redirects, etc.
FRONTEND_URL=http://localhost:3000

# Server port (default: 8000)
PORT=8000

# =============================================================================
# Python Configuration
# =============================================================================
# IMPORTANT: Must be set to 'src' for imports to work correctly
PYTHONPATH=src
