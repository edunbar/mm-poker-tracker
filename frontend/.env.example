# =============================================================================
# HomeGame Frontend Environment Configuration
# =============================================================================
# Copy this file to .env.local for local development
# DO NOT commit .env.local to version control - it may contain local overrides!

# =============================================================================
# Clerk Authentication
# =============================================================================
# Get your publishable key from Clerk dashboard: https://dashboard.clerk.com
# This is safe to expose in the frontend (it's public)
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# =============================================================================
# Backend API Configuration
# =============================================================================
# URL of your backend API server
# Local development:
REACT_APP_API_URL=http://localhost:8000

# Staging:
# REACT_APP_API_URL=https://poker-backend-staging-360080248475.us-central1.run.app

# Production:
# REACT_APP_API_URL=https://poker-backend-6t2w34itkq-uc.a.run.app
