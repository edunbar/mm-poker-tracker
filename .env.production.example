# Production Environment Configuration
# Copy this file to .env.production and fill in secure values

# Database Configuration
POSTGRES_USER=poker_prod_user
POSTGRES_PASSWORD=CHANGE_TO_SECURE_PASSWORD_MIN_32_CHARS
POSTGRES_DB=poker_analytics_prod
POSTGRES_PORT=5432

# Flask Environment
FLASK_ENV=production
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Security Note:
# - Use a strong password generator for POSTGRES_PASSWORD
# - Never commit actual .env.production file to version control
# - Consider using managed database services for production