# Database Configuration
POSTGRES_USER=poker_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=poker_analytics
POSTGRES_PORT=5432

# pgAdmin (Development Only)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=secure_admin_password

# Flask Environment
FLASK_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Note: For production deployment, create .env.production with stronger passwords
# and set FLASK_ENV=production