# =================================================================
# Poker Analytics Application Environment Configuration
# =================================================================
# Copy this file to .env and update the values for your setup

# =================================================================
# DATABASE CONFIGURATION
# =================================================================

# PostgreSQL connection settings
POSTGRES_USER=pokeruser
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=poker_analytics
POSTGRES_PORT=5432

# Database URL for backend connection
# For Docker: postgresql+psycopg2://user:password@db:5432/database
# For local: postgresql+psycopg2://user:password@localhost:5432/database
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}

# =================================================================
# BACKEND CONFIGURATION
# =================================================================

# Flask server port
PORT=8000

# Flask environment (development/production)
FLASK_ENV=development

# Python path for imports (used in Docker)
PYTHONPATH=/app/src

# =================================================================
# GAME CONFIGURATION
# =================================================================

# Your game's unique codes
REACT_APP_PUBLIC_CODE=C4QROK
REACT_APP_ADMIN_CODE=2LT8wByw4sMLAwB_ISq2TMRwJ6zaUZ1oy4w7y4WQscE

# Optional game title
GAME_TITLE=My Poker Game

# =================================================================
# PGADMIN CONFIGURATION (Database UI)
# =================================================================

# pgAdmin web interface credentials
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=adminadmin

# =================================================================
# FRONTEND CONFIGURATION
# =================================================================

# Backend API URL (for frontend to connect to backend)
REACT_APP_API_URL=http://localhost:8000/api/games

# React development server port
REACT_APP_PORT=3000

# =================================================================
# GOOGLE SHEETS INTEGRATION (OPTIONAL)
# =================================================================

# Google Sheets configuration
# NOTE: Service account JSON file path is currently hardcoded in:
# backend/src/services/sheets_service.py (line 7)
# You'll need to update that file with your service account file path

# Google Sheets IDs (if you want to override defaults)
GAME_LEDGER_SHEET_ID=18NVq3om_d5I-oGrwTT_f8BmyVFwz8Q3uFoPVNAFtxME
NAME_VALIDATION_SHEET_ID=18NVq3om_d5I-oGrwTT_f8BmyVFwz8Q3uFoPVNAFtxME

# =================================================================
# SECURITY CONFIGURATION
# =================================================================

# Flask secret key for session security (generate a random string)
SECRET_KEY=your-very-long-random-secret-key-here

# Admin session timeout (in seconds)
ADMIN_SESSION_TIMEOUT=3600

# =================================================================
# PERFORMANCE CONFIGURATION
# =================================================================

# Database connection pool settings
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_RECYCLE=3600

# React Query cache settings (in milliseconds)
REACT_QUERY_STALE_TIME=300000  # 5 minutes
REACT_QUERY_CACHE_TIME=600000  # 10 minutes

# =================================================================
# DEVELOPMENT/DEBUG CONFIGURATION
# =================================================================

# Enable debug logging
DEBUG=true

# Enable SQL query logging
LOG_SQL_QUERIES=false

# Enable React Query devtools
REACT_QUERY_DEVTOOLS=true

# =================================================================
# PRODUCTION CONFIGURATION
# =================================================================
# Uncomment and configure these for production deployment

# Production database URL
# DATABASE_URL=postgresql://user:password@production-db-host:5432/poker_analytics

# Production backend URL
# REACT_APP_API_URL=https://your-domain.com/api/games

# Disable debug features in production
# DEBUG=false
# FLASK_ENV=production
# REACT_QUERY_DEVTOOLS=false

# Production-grade admin codes (generate secure random strings)
# REACT_APP_ADMIN_CODE=your-super-secure-64-character-admin-code-here

# =================================================================
# DOCKER CONFIGURATION
# =================================================================

# Docker container names (optional customization)
POSTGRES_CONTAINER_NAME=poker_db
BACKEND_CONTAINER_NAME=poker_backend
PGADMIN_CONTAINER_NAME=poker_pgadmin

# Docker network name
DOCKER_NETWORK_NAME=poker_network

# =================================================================
# MONITORING & LOGGING (PRODUCTION)
# =================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn-here

# Application monitoring (optional)
# APM_SERVICE_NAME=poker-analytics
# APM_SERVER_URL=https://your-apm-server

# =================================================================
# BACKUP CONFIGURATION (PRODUCTION)
# =================================================================

# Database backup settings
# BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
# BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET=your-backup-bucket

# =================================================================
# SSL/TLS CONFIGURATION (PRODUCTION)
# =================================================================

# SSL certificate paths (for HTTPS)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# Force HTTPS redirects
# FORCE_HTTPS=true